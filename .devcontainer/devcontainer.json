{
  "name": "Arya Bank sandbox",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/java:1": { "version": "17", "installMaven": "true" }
  },
  "postCreateCommand": "pip install --user -r services/payments-api/requirements.txt pytest httpx",
  "postAttachCommand": {
    "sandbox": "python run_sandbox.py"
  },
  "forwardPorts": [4173, 8000],
  "portsAttributes": {
    "4173": { "label": "Net banking", "onAutoForward": "openBrowser" },
    "8000": { "label": "Payments API (/docs)", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "humao.rest-client", "qwtel.sqlite-viewer"]
    }
  }
}
